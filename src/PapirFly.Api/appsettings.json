{
  "Storage": {
    "Provider": "InMemory"
  },
  // PostgreSQL alternative: replace Storage above, and provide the password through configuration.
  // "Storage": {
  //   "Provider": "PostgreSql",
  //   "ConnectionString": "Host=localhost;Port=5432;Database=papirfly;Username=papirfly;Password=CHANGE_ME"
  // },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Properties": {
      "Application": "PapirFly.Api"
    }
  },
  "AllowedHosts": "*"
}
